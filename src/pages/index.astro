---
import LayoutLt from "../layouts/Layout_Lt.astro";
import "../styles/style.css";
import Team from "../assets/TeamFromDrone.png";
import "../styles/index.css";
import GIF from "../assets/CarDriving.gif";
import Ansys from "../assets/sponsors/ansys.png";
import favicon from "../assets/favicon.png"
import Rapid from "../assets/sponsors/rapidharness.png"
import SolidWorks from "../assets/sponsors/SolifWorks.png"
---

<html lang="lt">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="format-detection" content="email=no">
    <link rel="icon" href={favicon.src}>
    <link rel="canonical" href="https://perkunasrt.com" />
    <meta name="description" content="Esame studentų komanda iš Lietuvos, kurianti lenktyninį automobilį „Formula Student“ varžyboms. Derindami inžineriją, verslą ir projektų valdymą, 
    ugdome būsimus lyderius per praktinę patirtį.">
    <title>Perkūnas RT - „Formula Student“ komanda iš Lietuvos | Lenktyninių automobilių inžinerija ir inovacijos</title>
  </head>
  <body>
    <LayoutLt>
      <img src={Team.src} alt="Perkūnas RT studentų komanda - lenktyninis automobilis iš Lietuvos" class="TeamImg first" />
      <div class="b-block">
        <div class="container slogan">
          <div class="slogan-text">
            <h1>Ateities Greitis</h1>
            <p class="first-p">
              Projektuojame ne tik automobilį, bet ir kuriame ateities viziją
            </p>
          </div>
          <div class="slogan-image">
            <img src={GIF.src} alt="Perkūnas RT bolidas važiuoja trasoje" class="image-y" />
          </div>
        </div>
      </div>
      <div class="b-w"></div>
      <div class="w-block">
        <div class="container sponsors">
          <h1>Mūsų Partneriai</h1>
          <div class="sponsor-row">
            <a href="https://www.ansys.com" target="_blank"><img src={Ansys.src} alt="Ansys" height="120px" /></a>
            <a href="https://rapidharness.com" target="_blank"><img src={Rapid.src} alt="RapidHarness" height="120px" /></a>
            <a href="https://www.solidworks.com/" target="_blank"><img src={SolidWorks.src} alt="SolidWorks" height="120px" /></a>
          </div>
        </div>
      </div>
    </LayoutLt>
  </body>
</html>
