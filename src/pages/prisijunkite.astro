---
import LayoutLt from "../layouts/Layout_Lt.astro";
import "../styles/style.css";
import "../styles/join-us.css";
import Team from "../assets/Team.png";
import favicon from "../assets/favicon.png"
import TeamDrone from "../assets/TeamFromDrone.png";
---

<html lang="lt">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="format-detection" content="email=no">

    <link rel="icon" type="image/png" href={favicon.src}> 
    <title>Perkūnas RT | Prisijunkite</title>
    <meta name="description" content="Norite prisijungti prie Perkūnas RT komandos? Sužinokite, kokią patirtį įgysite prisijungę prie mūsų studentų Formula Student projekto." />

    <link rel="canonical" href="https://perkunasrt.com/prisijunkite" />
    <link rel="alternate" hreflang="lt" href="https://perkunasrt.com/prisijunkite" />
    <link rel="alternate" hreflang="en" href="https://perkunasrt.com/en/join-us" />

    <!-- Open Graph -->
    <meta property="og:title" content="Perkūnas RT | Prisijunkite" />
    <meta property="og:description" content="Prisijunkite prie mūsų komandos ir įgykite praktinės patirties inžinerijos, verslo bei „Formula Student“ projektuose." />
        <meta property="og:image" content={TeamDrone.src}>
    <meta property="og:url" content="https://perkunasrt.com/prisijunkite" />
    <meta property="og:type" content="website" />

  </head>
  <body>
    <LayoutLt>
      <div class="y-block first">
        <div class="container join-us">
          <div class="to-join">
            <div>
              <h1>Norite prisijungti?</h1>
              <p class="first-p">
                Norėdami prisijungti spauskite žemiau esantį mygtuką ir
                užpildykite formą. Naujų narių ieškome rugsėjo ir vasario
                mėnesiais, tačiau jei turite patirties inžinerijos, verslo
                srityse ar net „Formula Student" varžybose - į tai
                atsižvelgsime.
              </p>
              <a class="button b-block" href="https://docs.google.com/forms/d/e/1FAIpQLSdwLiYJsdeDij5YE5FDXWvOn8sIecHKf9AITatkuBPsYKg6zQ/viewform" target="_blank">PRISIJUNGTI</a>
            </div>
            <div>
                <img src={Team.src} alt="Perkunas RT komanda" width="100%" class="image-b">
            </div>
          </div>
          <div class="join-info">
            <h1>Ką gausite prisijungę?</h1>
            <ul>
              <li class="first-p">
                Įgysite praktinės patirties kuriant, projektuojant ir testuojant
                aukštos kokybės transporto priemonę.
              </li>
              <li>
                Dirbant su remėjais ir atstovaujant komandą, išmoksite apie
                verslą, marketingą ir projektų valdymą.
              </li>
              <li>
                Vystysite komandinio darbo, lyderystės ir laiko valdymo įgūdžius
                bendradarbiaujančioje aplinkoje.
              </li>
              <li>
                Sukursite ryšius su universiteto dėstytojais ir pramonės
                partneriais, plečiant profesinį tinklą.
              </li>
              <li>
                Įgysite vertingų žinių ir įgūdžių, kurie padės pasiruošti
                būsimiems inžinerijos ir verslo iššūkiems.
              </li>
            </ul>
          </div>
        </div>
      </div>
    </LayoutLt>
  </body>
</html>
