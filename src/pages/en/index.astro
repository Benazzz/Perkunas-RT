---
import LayoutEn from "../../layouts/Layout_En.astro";
import "../../styles/style.css";
import Team from "../../assets/TeamFromDrone.png";
import "../../styles/index.css";
import GIF from "../../assets/CarDriving.gif";
import Ansys from "../../assets/sponsors/ansys.png";
import favicon from "../../assets/favicon.png" 
import Rapid from "../../assets/sponsors/rapidharness.png"
import SolidWorks from "../../assets/sponsors/SolifWorks.png"
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="format-detection" content="email=no">
    
    <link rel="icon" type="image/png" href={favicon.src}> 
    <link rel="canonical" href="https://perkunasrt.com" />
    <meta name="description" content="We are a student team from Lithuania building a race car for the Formula Student competition. Combining engineering, 
    business, and project management, we develop future leaders through hands-on experience.">
    <title>Perkunas RT – Formula Student Team from Lithuania | Race Car Engineering & Innovation</title>

      <!-- Open Graph -->
    <link rel="alternate" hreflang="lt" href="https://perkunasrt.com/" />
    <link rel="alternate" hreflang="en" href="https://perkunasrt.com/en/" />
    <meta property="og:title" content="Perkunas RT – Formula Student Team from Lithuania" />
    <meta property="og:description" content="Building a race car for the Formula Student competition while developing future leaders in engineering, business, and project management." />
    <meta property="og:image" content={Team.src} />
    <meta property="og:url" content="https://perkunasrt.com" />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <LayoutEn>
      <img src={Team.src} alt="Perkunas RT Formula Student Team" class="TeamImg first" />
      <div class="b-block">
        <div class="container slogan">
          <div class="slogan-text">
            <h1>The Speed of The Future</h1>
            <p class="first-p">
              We are not only designing a car, but also creating a vision of the future
            </p>
          </div>
          <div class="slogan-image">
            <img src={GIF.src} alt="Perkunas RT race car on the track" class="image-y" />
          </div>
        </div>
      </div>
      <div class="b-w"></div>
      <div class="w-block">
        <div class="container sponsors">
          <h1>Our Sponsors</h1>
          <div class="sponsor-row">
            <a href="https://www.ansys.com" target="_blank"><img src={Ansys.src} alt="Ansys" height="120px" /></a>
            <a href="https://rapidharness.com" target="_blank"><img src={Rapid.src} alt="RapidHarness" height="120px" /></a>
            <a href="https://www.solidworks.com/" target="_blank"><img src={SolidWorks.src} alt="SolidWorks" height="120px" /></a>
          </div>
        </div>
      </div>
    </LayoutEn>
  </body>
</html>
