---
import LayoutEn from "../../layouts/Layout_En.astro";
import "../../styles/style.css"
import "../../styles/partner.css"
import favicon from "../../assets/favicon.png" 
import Ansys from "../../assets/sponsors/ansys.png"
import EasyComposition from "../../assets/sponsors/easy-composites.png"
import Nuke from "../../assets/sponsors/nuke_performance.png"
import Rapid from "../../assets/sponsors/rapidharness.png"
import Grade from "../../assets/sponsors/Vi-Grade.png"
import Hostinger from "../../assets/sponsors/hostinger.png"
import Injector from "../../assets/sponsors/injector-dynamics.png"
import ProWire from "../../assets/sponsors/pro-wire.png"
import RaceSpec from "../../assets/sponsors/race-spec.png"
import Radium from "../../assets/sponsors/radium-engineering.png"
import Skf from "../../assets/sponsors/skf.png"
import SolidWorks from "../../assets/sponsors/SolifWorks.png"
import Xtra from "../../assets/sponsors/xtra-motorsport.png"
import Team from "../../assets/TeamFromDrone.png";
import Iremas from "../../assets/sponsors/Iremas.png"
---
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="format-detection" content="email=no">

        <link rel="icon" type="image/png" href={favicon.src}> 
        <title>Perkūnas RT | Partners</title>
          <meta
            name="description"
            content="Explore our valued partners and sponsors at Perkūnas RT. Join a dynamic collaboration supporting engineering, innovation, and motorsport excellence."
        />

        
        <!-- Open Graph Tags -->
        <link rel="alternate" hreflang="lt" href="https://perkunasrt.com/partneriai" />
        <link rel="alternate" hreflang="en" href="https://perkunasrt.com/en/partners" />
        <link rel="canonical" href="https://perkunasrt.com/partners" />
        <meta property="og:title" content="Partners | Perkūnas RT – Driving Innovation in Engineering" />
        <meta
            property="og:description"
            content="Discover the esteemed partners supporting Perkūnas RT, a Formula Student team dedicated to engineering excellence and motorsport innovation."
        />
        <meta property="og:image" content={Team.src} />
        <meta property="og:url" content="https://perkunasrt.com/partners" />
        <meta property="og:type" content="website" />
    </head>
    <body>
        <LayoutEn>
            <div class="y-block first">
                <div class="container card">
                    <div>
                        <a href="/en/contact-us" class="contact">
                            <h1>Contribute to our success!</h1>
                        </a>
                        <p class="first-p">
                            Sponsorship provides a top-level opportunity to become part of the dynamic Formula Student project. Your brand will gain high visibility on our 
                            race car, team apparel, as well as through advertisements, events, and performances at competitions.
                          </p>
                          <p>
                            Sponsors have a unique opportunity to influence our technical, strategic, and operational development by establishing direct connections with 
                            future engineers and innovators. This partnership offers a direct link to education and helps shape future talent.
                          </p>
                          <p>
                            We aim to build long-term relationships that span multiple seasons, ensuring continuous mutual benefit. Your support also gives you priority 
                            access to talented engineering students who will be suitable for future job and internship opportunities.
                          </p>
                          <p>
                            By joining from the beginning, you will become part of our entire journey – from the idea to the competition. You'll help create not just a race car, 
                            but also a culture of innovation and excellence.
                          </p>
                          <p>
                            To learn more, download the <a href="https://drive.google.com/drive/u/0/folders/1NvpyICqW732AsfOA1Ias6yKZ66zEEPlm?dmr=1&ec=wgc-drive-hero-goto&sort=13&direction=a" target="_blank" class="brochure">brochure</a>.
                          </p>
                </div>
            </div>
            <div class="y-w">

            </div>
            <div class="w-block">
                <div class="container card">
                    <h1 class="partners-header">Our sponsors</h1>
                    <div class="partner">
                        <div class="sponsor-logo">
                            <a href="https://www.iremas.lt/" target="_blank"><img src={Iremas.src} alt="Iremas"/></a>
                        </div>
                        <div class="sponsor-info">
                            <h2>Iremas</h2>
                            <p class="first-p">It is one of the leading industrial maintenance and engineering solutions companies in Lithuania, providing high-quality services to the energy, industrial, and infrastructure sectors. 
                                The company specializes in mechanical equipment installation, electrical engineering, automation, and industrial facility maintenance. With over four decades of experience, Iremas successfully carries 
                                out both local and international projects, ensuring safety, reliability, and high work quality. A wide range of partners use the company's services – from the energy and chemical industries to transport 
                                infrastructure and manufacturing companies.</p>
                            </p>
                        </div>
                    </div>
                    <div class="partner">
                        <div class="sponsor-logo">
                            <a href="https://www.ansys.com/" target="_blank"><img src={Ansys.src} alt="Ansys"/></a>
                        </div>
                        <div class="sponsor-info">
                            <h2>Ansys</h2>
                            <p class="first-p">
                                It is a global leader in engineering simulation software, offering advanced solutions for product development, testing, and optimization. 
                                The company's software allows for modeling fluid dynamics, structures, electromagnetics, heat, and multiphysics processes. Ansys solutions 
                                are used by various industries – from automotive and aerospace to energy and healthcare.
                              </p>
                              
                        </div>
                    </div>
                    <div class="partner">
                        <div class="sponsor-logo">
                            <a href="https://rapidharness.com" target="_blank"><img src={Rapid.src} alt="RapidHarness" /></a>
                        </div>
                        <div class="sponsor-info">
                            <h2>RapidHarness</h2>
                            <p class="first-p">It is an advanced wiring design software developed to automate and streamline the entire electrical system design process – from 
                                the first schematic to production-ready documentation. This CAD platform enables real-time creation of professional schematics, automated 
                                documentation generation, and efficient collaboration within teams or with external partners. RapidHarness solutions are used by engineers 
                                across various industries – from automotive and aerospace to electronics and manufacturing. </p>
                        </div>
                    </div>
                    <div class="partner">
                        <div class="sponsor-logo">
                            <a href="https://www.solidworks.com/" target="_blank"><img src={SolidWorks.src} alt="SolidWorks" /></a>
                        </div>
                        <div class="sponsor-info">
                            <h2>SolidWorks</h2>
                            <p class="first-p">
                                It is a global leader in 3D design and engineering solutions, developing advanced software for product development, engineering, and manufacturing. The company specializes in 
                                computer-aided design (CAD), analysis (CAE), and product data management (PDM) systems, helping businesses create innovative, efficient, and sustainable solutions. SolidWorks 
                                solutions are used across various sectors – from automotive and aerospace to medical devices, electronics, and educational institutions worldwide. The company's mission is to 
                                provide engineers with tools that foster creativity, streamline development processes, and accelerate time-to-market.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="b-block " style="height: 10px;"></div>
            <div class="w-block">
                <div class="container sponsor-row">
                    <a href="https://www.easycomposites.eu/" target="_blank"><img src={EasyComposition.src} alt="Easy Composites" height="60px" /></a>
                    <a href="https://www.nukeperformance.com/" target="_blank"><img src={Nuke.src} alt="Nuke Performance" height="60px" /></a>
                    <a href="https://www.vi-grade.com/" target="_blank"><img src={Grade.src} alt="VI-grade" height="55px" /></a>
                    <a href="https://www.hostinger.com/" target="_blank"><img src={Hostinger.src} alt="Hostinger" height="50px" /></a>
                    <a href="https://injectordynamics.com/" target="_blank"><img src={Injector.src} alt="Injector Dynamics" height="50px" /></a>
                    <a href="https://www.prowireusa.com/" target="_blank"><img src={ProWire.src} alt="ProWireUsa" height="60px" /></a>
                    <a href="https://racespeconline.com/" target="_blank"><img src={RaceSpec.src} alt="Race Spec" height="60px" /></a>
                    <a href="https://www.radiumauto.com/" target="_blank"><img src={Radium.src} alt="Radium Engineering" height="60px" /></a>
                    <a href="https://www.skf.com/" target="_blank"><img src={Skf.src} alt="SKF" height="60px" /></a>
                    <a href="https://xtramotorsport.com/" target="_blank"><img src={Xtra.src} alt="Xtra Motorsport" height="45px" /></a>
                </div>
            </div>
        </LayoutEn>
    </body>
</html>
