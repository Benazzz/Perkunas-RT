---
import LayoutEn from "../../layouts/Layout_En.astro";
import "../../styles/style.css"
import GPM from "../../assets/gpm.png"
import "../../styles/support-us.css"
import favicon from "../../assets/favicon.png" 
import Team from "../../assets/TeamFromDrone.png";
---
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="format-detection" content="email=no">

        <link rel="icon" type="image/png" href={favicon.src}> 
        <title>Perkūnas RT | Support us</title>
        <meta
            name="description"
            content="Support the Perkūnas RT team and help build the future of engineering! Learn how to donate 1.2% GPM or contribute through other platforms. Your support fuels innovation, teamwork, and motorsport excellence."
        />

        <!-- Open Graph Tags -->
        <link rel="alternate" hreflang="lt" href="https://perkunasrt.com/paremkite" />
        <link rel="alternate" hreflang="en" href="https://perkunasrt.com/en/support-us" />
        <link rel="canonical" href="https://perkunasrt.com/support-us" />
        <meta property="og:title" content="Support us | Perkūnas RT - Help Build the Future of Engineering" />
        <meta
            property="og:description"
            content="Help the Perkūnas RT team by donating 1.2% GPM or supporting through crowdfunding platforms. Together, we'll build a competitive race car and foster engineering talent."
        />
        <meta property="og:image" content={Team.src} />
        <meta property="og:url" content="https://perkunasrt.com/support-us" />
        <meta property="og:type" content="website" />
    </head>
    <body>
        <LayoutEn>
            <div class="w-block first">
                <div class="container card">
                    <div class="GPM">
                        <h1>Donate 1.2% GPM!</h1>
                        <div class="first-p"><img src={GPM.src} alt="Give 1.2% GPM to PerkunasRT team"  class="image-b"></div>
                    </div>
                    <div class="support">
                        <h1>Support us!</h1>
                        <p class="first-p">If you would like to help us, simply follow the steps in 
                            <a href="https://ugc.production.linktr.ee/6f3133ff-ddb9-463b-bd75-395c8c29b987_1-2-paramos-gidas--2-.pdf" target="_blank" class="pdf">
                            this PDF file</a>. After filling out the application, please send us the confirmation PDF by email at <span class="support-email">
                                perkunasrt@gmail.com</span>.</p>
                        <p>As a thank you, we will proudly write your name on our car. 🚗💨</p>
                        <p>You can also contribute by transferring a certain amount through the following platforms:</p>
                        <div class="donate">
                            <a href="https://gogetfunding.com/?p=9141413" target="_blank" class="b-block button">Gogetfunding</a>
                            <a href="https://whydonate.com/en/fundraising/perkunasrt-formula-student-team-ktu" target="_blank" class="b-block button">Whydonate</a>
                        </div>
                    </div>
                </div>
            </div>
        </LayoutEn>
    </body>
</html>